{
    "name": "you/gesture-photobooth",
    "type": "project",
    "description": "Gesture-controlled photobooth with a Laravel backend and SQLite storage.",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true, "sort-packages": true, "policy": { "advisories": { "block": false } } 
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
